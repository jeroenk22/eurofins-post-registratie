# Kopieer dit bestand naar .env en vul de webhook URL in
# Aanmaken in Make.com: Webhooks module → Create a webhook → kopieer de URL
VITE_WEBHOOK_URL=https://hook.eu2.make.com/jouw-webhook-url-hier
NETLIFY_WEBHOOK_URL=https://jouw-netlify-function-url-hier/.netlify/functions/create-order
NETLIFY_WEBHOOK_SECRET=jouw-gedeelde-secret-hier
VITE_APP_URL=https://jouw-site.netlify.app

# Google Sheets (server-side, via een service account; de sheet kan dus privé blijven)
# Maak een service account in Google Cloud, zet de Sheets API aan en deel de sheet (alleen lezen) met het e-mailadres van het account
GOOGLE_SHEETS_ID=jouw-sheet-id-hier
GOOGLE_SA_EMAIL=naam@project.iam.gserviceaccount.com
# De private key uit het JSON-bestand van het account; letterlijke \n-tekens zijn toegestaan
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\njouw-key-hier\n-----END PRIVATE KEY-----\n"

# Toegangsbeheer per netwerk (AVG): aparte Google Sheet "Post-app toegang" met een tabblad "Netwerken"
# Deel de sheet als Bewerker met hetzelfde service account als hierboven; het ID staat in de URL van de sheet
GOOGLE_TOEGANG_SHEET_ID=jouw-toegang-sheet-id-hier
